# A1.3 CSV or SQL?  Build a realistic October: 12 stations x 31 days x 24 h 
# --------------------------------------------------------------------------- 
STATIONS = ["Adyar", "Guindy", "Velachery", "T Nagar", "Anna Nagar", "Mylapore", 
            "Tambaram", "Perungudi", "Kodambakkam", "Egmore", "Royapuram", "Manali"] 
rnd = random.Random(1) 
folder = tempfile.mkdtemp() 
all_rows = [] 
for sid, name in enumerate(STATIONS, 1): 
    base = 40 + 6 * sid 
    for d in range(1, 32): 
        day = f"2026-10-{d:02d}" 
        lines = ["date,hour,pm25,pm10,no2,temp"] 
        for h in range(24): 
            rush = 25 if h in (8, 9, 18, 19, 20) else 0 
            pm = round(base + rush + rnd.gauss(0, 8), 1) 
            lines.append(f"{day},{h},{pm},{pm*1.8:.1f},{20+rnd.random()*20:.1f}," 
                         f"{26+rnd.gauss(0,2):.1f}") 
            all_rows.append((sid, day, h, pm)) 
        with open(os.path.join(folder, f"{name}_{day}.csv"), "w") as f: 
            f.write("\n".join(lines)) 
print(f"\nWrote {len(os.listdir(folder))} CSV files ({len(all_rows):,} readings)") 
  
con.executemany("INSERT INTO stations(station_id, name) VALUES (?, ?)", 
                list(enumerate(STATIONS, 1))) 
con.executemany( 
    "INSERT INTO readings(station_id, day, hour, pm25) VALUES (?,?,?,?)", all_rows) 
con.commit() 
  
def timed(func): 
    start = time.perf_counter(); result = func() 
    return result, time.perf_counter() - start 
  
# Question 1: average PM2.5 of Adyar in October 
def q1_csv(): 
    total = count = 0 
    for fn in os.listdir(folder): 
        if fn.startswith("Adyar_"): 
            for r in csv.DictReader(open(os.path.join(folder, fn))): 
                total += float(r["pm25"]); count += 1 
    return round(total / count, 2) 
def q1_sql(): 
    sql = """SELECT AVG(pm25) FROM readings r JOIN stations s USING(station_id) 
             WHERE s.name='Adyar' AND day LIKE '2026-10%'""" 
    return round(con.execute(sql).fetchone()[0], 2) 
