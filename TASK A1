# A1.2 DESIGN THE STORAGE (SQLite) 
# --------------------------------------------------------------------------- 
SCHEMA = """ 
CREATE TABLE stations ( 
    station_id INTEGER PRIMARY KEY,      -- surrogate key 
    name       TEXT NOT NULL UNIQUE,     -- 'Adyar' (standard Title case) 
    temp_unit  TEXT NOT NULL DEFAULT 'C' -- 'C' or 'F' (2 stations send F) 
); 
CREATE TABLE readings ( 
    station_id INTEGER NOT NULL REFERENCES stations(station_id), 
    day        TEXT    NOT NULL,         -- 'YYYY-MM-DD' 
    hour       INTEGER NOT NULL,         -- 0..23 
    pm25       REAL,                     -- ug/m3 (NULL = missing) 
    pm10       REAL, 
    no2        REAL, 
2 
    temp_c     REAL,                     -- always stored in Celsius 
    PRIMARY KEY (station_id, day, hour)  -- one reading per station per hour 
                                         -- (also rejects duplicate rows) 
); 
CREATE INDEX idx_station_day ON readings(station_id, day); 
""" 
con = sqlite3.connect(":memory:") 
con.executescript(SCHEMA) 
print("\nTables created:", 
      [r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")]) 
print("readings columns (name, type, primary-key position):") 
for cid, name, typ, notnull, default, pk in con.execute("PRAGMA table_info(readings)"): 
