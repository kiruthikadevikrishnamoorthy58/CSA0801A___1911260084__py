# ALTERNATIVE: keep CSV only and load into a pandas DataFrame for each question 
# --------------------------------------------------------------------------- 
def pandas_q1(): 
    df = pd.concat((pd.read_csv(os.path.join(folder, fn)).assign(st=fn.split("_")[0]) 
                    for fn in os.listdir(folder))) 
    return round(df[df.st == "Adyar"].pm25.mean(), 2) 
r, t = timed(pandas_q1) 
print(f"pandas (reload all CSV for the question): Q1 = {r} in {t:.4f}s") 
# Time per question: CSV/pandas must open and scan ALL n readings every time 
# = O(n) (plus file opening cost). SQLite with an index on (station_id, day) 
# jumps straight to the needed rows = about O(log n + k) for k matching rows 
# (a GROUP BY over every row is still O(n), but without opening 372 files). 
# Space: pandas holds the whole data in MEMORY (about n x columns x 8 bytes); 
# SQLite keeps data on DISK and brings only the needed pages into memory. 
# Conclusion: SQLite for repeated questions; CSV stays only as the daily 
# delivery format from the stations.