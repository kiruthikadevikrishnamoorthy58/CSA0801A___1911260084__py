# Question 2: which hour of the day has the worst (highest) average PM2.5? 
def q2_csv(): 
    tot = [0.0] * 24; cnt = [0] * 24 
    for fn in os.listdir(folder): 
        for r in csv.DictReader(open(os.path.join(folder, fn))): 
            tot[int(r["hour"])] += float(r["pm25"]); cnt[int(r["hour"])] += 1 
    means = [t / c for t, c in zip(tot, cnt)] 
    return means.index(max(means)) 
def q2_sql(): 
    return con.execute("""SELECT hour FROM readings GROUP BY hour 
                          ORDER BY AVG(pm25) DESC LIMIT 1""").fetchone()[0] 
  
# Question 3: stations whose October mean PM2.5 is above 80 
def q3_csv(): 
    tot, cnt = {}, {} 
    for fn in os.listdir(folder): 
        st = fn.rsplit("_", 1)[0] 
        for r in csv.DictReader(open(os.path.join(folder, fn))): 
            tot[st] = tot.get(st, 0) + float(r["pm25"]); cnt[st] = cnt.get(st, 0) + 1 
    return sorted(s for s in tot if tot[s] / cnt[s] > 80) 
def q3_sql(): 
    return sorted(r[0] for r in con.execute("""SELECT s.name FROM readings r 
        JOIN stations s USING(station_id) GROUP BY s.name 
        HAVING AVG(pm25) > 80""")) 
  
print(f"\n{'Question':36}{'CSV files':>12}{'SQL':>10}  same answer") 
for label, fc, fs in [("Q1 avg PM2.5, Adyar, October", q1_csv, q1_sql), 
                      ("Q2 worst hour of the day", q2_csv, q2_sql), 
                      ("Q3 stations with mean above 80", q3_csv, q3_sql)]: 
    (rc, tc), (rs, ts) = timed(fc), timed(fs) 
    shown = f"{len(rc)} stations" if isinstance(rc, list) else rc 
    print(f"{label:36}{tc:>11.4f}s{ts:>9.4f}s  {rc == rs}  ({shown})") 
  
