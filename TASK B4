POSITIVE = {"good", "clean", "fast", "helpful", "improved"} 
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"} 
NEGATORS = {"not", "never", "no"}
def score(text): 
    """+1 per positive word, -1 per negative word; a preceding negator flips it.""" 
    words = text.lower().replace(".", " ").replace(",", " ").split() 
    total = 0 
    # TODO 1: value of each word (+1, -1 or 0); flip the sign if the previous 
    #         word is a negator; add it to total 
    for i, w in enumerate(words): 
        value = 1 if w in POSITIVE else -1 if w in NEGATIVE else 0 
        if i > 0 and words[i - 1] in NEGATORS: 
            value = -value                      # 'not good' -> -1, 'not bad' -> +1 
        total += value 
    return total 
  
def label(text): 
    s = score(text) 
    return "positive" if s > 0 else "negative" if s < 0 else "neutral" 
  
