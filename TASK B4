# --- extractive summariser (from A5): most frequent important words --- 
STOP = {"the", "a", "an", "is", "are", "was", "were", "of", "in", "on", "at", "and", 
        "to", "it", "this", "that", "for", "from", "with", "by", "our", "we", "has"} 
def words_of(text): 
    return re.sub(r"[^a-z' ]", " ", text.lower()).split() 
  
def summarise(text, n=3): 
    sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", text) if s.strip()] 
    freq = Counter(w for w in words_of(text) if w not in STOP) 
    def sc(s): 
        ws = [w for w in words_of(s) if w not in STOP] 
        return sum(freq[w] for w in ws) / (len(ws) or 1) 
    best = sorted(sentences, key=sc, reverse=True)[:n] 
    return [s for s in sentences if s in best] 
