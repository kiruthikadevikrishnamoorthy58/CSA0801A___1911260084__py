# --------------------------------------------------------------------------- 
# ALTERNATIVE: the same table with Python loops after reading ALL rows 
# --------------------------------------------------------------------------- 
def summary_python(rows): 
    groups = defaultdict(list)                 # (station, day) -> all values 
    for station, day, hour, pm in rows: 
        if pm is not None: 
            groups[(station, day)].append(pm)  # whole data kept in memory 
    return {k: (min(v), max(v), round(statistics.mean(v), 1), len(v)) 
            for k, v in sorted(groups.items())} 
  
python_result = summary_python(small) 
