# Time and memory for n readings (12 stations, growing number of days) 
print(f"\n{'n readings':>11} {'SQL time':>10} {'Python time':>12} " 
      f"{'SQL mem KB':>11} {'Python mem KB':>14}") 
for days in (10, 100, 365): 
    rows = make_readings(12, days) 
    con = sqlite3.connect(":memory:") 
    con.execute("CREATE TABLE readings (station TEXT, day TEXT, hour INT, pm25 REAL)") 
    con.executemany("INSERT INTO readings VALUES (?,?,?,?)", rows) 
  
    tracemalloc.start(); t = time.perf_counter() 
    result_sql = con.execute(SQL).fetchall() 
    t_sql = time.perf_counter() - t 
    mem_sql = tracemalloc.get_traced_memory()[1] / 1024; tracemalloc.stop() 
  
    tracemalloc.start(); t = time.perf_counter() 
    result_py = summary_python(rows) 
    t_py = time.perf_counter() - t 
    mem_py = tracemalloc.get_traced_memory()[1] / 1024; tracemalloc.stop() 
    print(f"{len(rows):>11,} {t_sql:>9.4f}s {t_py:>11.4f}s {mem_sql:>11.0f} " 
          f"{mem_py:>14.0f}") 
# Time : both are O(n) - every reading is visited once. SQLite does it in 
#        compiled C code, so it is usually faster by a constant factor; the 
#        Python loop pays interpreter overhead on every row. 
# Memory: the Python version keeps ALL n valid readings in lists before it 
#        can compute min/max/mean: O(n). SQL GROUP BY keeps only a small 
#        running aggregate per group (about O(groups)) while it scans rows. 
# The Python version is still useful for checking the SQL result on small data 
# and when the rule is too complex to write in SQL.