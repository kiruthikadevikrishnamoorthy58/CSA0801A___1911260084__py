# A3.2 DAILY SUMMARY TABLE per station: min, max, mean, number of valid readings 
# Produced by:  SELECT station, day, MIN(pm25), MAX(pm25), AVG(pm25), 
#               COUNT(pm25) FROM readings GROUP BY station, day 
# (COUNT(pm25) ignores NULLs, so it is the number of VALID readings) 
# --------------------------------------------------------------------------- 
def make_readings(stations, days, seed=3): 
    rnd = random.Random(seed) 
    rows = [] 
    for s in range(stations): 
        for d in range(days): 
            for h in range(24): 
                pm = round(50 + 8 * s + rnd.gauss(0, 10), 1) 
                if rnd.random() < 0.05: 
                    pm = None                  # about 5% missing readings 
                rows.append((f"S{s+1:02d}", f"2026-10-{d+1:02d}", h, pm)) 
    return rows 
  
small = make_readings(2, 2) 
con = sqlite3.connect(":memory:") 
con.execute("CREATE TABLE readings (station TEXT, day TEXT, hour INT, pm25 REAL)") 
