# --------------------------------------------------------------------------- 
# B3.4 ENGINEERING TRADE-OFF 
# --------------------------------------------------------------------------- 
# Observed: all three give identical answers. Plain loops are slowest and grow 
# in a straight line with the data. pandas is fastest for a ONE-TIME analysis 
# of a file already on disk (a few lines, runs in compiled code), but must hold 
# the whole table in memory. SQL load+query is slower than pandas because 
# inserting every row costs time, BUT once the data is stored the GROUP BY 
# query alone is quick, and repeats cost no loading at all. 
# DECISION: 
#   quick one-time analysis  -> pandas (shortest code, fastest to write and run) 
#   daily automated report   -> SQLite + GROUP BY: store each day's clean data 
#                               once, query only what is needed, data persists, 
#                               and results are repeatable and easy to check. 
# Plain loops: only for tiny files or when no library may be installed. 
  
# --------------------------------------------------------------------------- 
# ALTERNATIVE: ONE pass with a running sum and count per (station, day) 
# --------------------------------------------------------------------------- 
def mean_running(text): 
    sums, counts = {}, {} 
    for r in csv.DictReader(io.StringIO(text)): 
        key = (r["station"], int(r["day"])) 
        sums[key] = sums.get(key, 0.0) + float(r["pm25"]) 
        counts[key] = counts.get(key, 0) + 1 
    return {k: sums[k] / counts[k] for k in sums} 
  
print("\nRunning-sum version equals statistics.mean version:", 
      all(abs(mean_running(small)[k] - a[k]) < 1e-9 for k in a)) 
print(f"\n{'method (12 stations)':26}{'time':>9}{'peak memory MB':>16}") 
for name, func in [("store all + statistics.mean", mean_loops), 
                   ("running sum + count", mean_running)]: 
    t = time.perf_counter(); func(texts[12]); t_run = time.perf_counter() - t 
    tracemalloc.start(); func(texts[12]) 
    peak = tracemalloc.get_traced_memory()[1] / 1e6; tracemalloc.stop() 
    print(f"{name:26}{t_run:>8.3f}s{peak:>16.1f}") 
# Time : O(n) for both - every reading is visited once; the running-sum version 
#        skips building lists and calling statistics.mean (which is slow, it 
#        uses exact fractions), so its constant factor is smaller. 
# Space: storing all readings first needs O(n) memory (every float kept); 
#        the running sums keep only two numbers per (station, day) group: 
#        O(stations x days) = 12 x 365 here, far smaller than n = 105,120. 
#        (The csv text itself is already in memory here; reading the file line 
#        by line would make the running-sum version use little memory in total.)