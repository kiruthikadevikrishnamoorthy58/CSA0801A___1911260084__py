# TASK B3 - Loops vs Libraries vs SQL: the daily mean PM2.5 per station 
import cProfile, csv, io, pstats, sqlite3, statistics, time, tracemalloc 
import numpy as np 
import pandas as pd 
  
STATIONS = [f"S{i:03d}" for i in range(1, 121)]          # up to 120 stations 
  
def make_csv(n_stations, days=365, seed=7): 
    """CSV text: station,day,hour,pm25 - about 8,760 readings per station.""" 
    g = np.random.default_rng(seed) 
    st = np.repeat(STATIONS[:n_stations], days * 24) 
    day = np.tile(np.repeat(np.arange(days), 24), n_stations) 
    hour = np.tile(np.arange(24), days * n_stations) 
    pm = (60 + 10 * np.sin(day / 58) + g.normal(0, 12, len(st))).round(1) 
    lines = [f"{s},{d},{h},{p}" for s, d, h, p in zip(st, day, hour, pm)] 
    return "station,day,hour,pm25\n" + "\n".join(lines) 
  
# --------------------------------------------------------------------------- 
# Method 1: plain Python loops with the csv module (store readings, then mean) 
# --------------------------------------------------------------------------- 
def mean_loops(text): 
    groups = {} 
    for r in csv.DictReader(io.StringIO(text)): 
        groups.setdefault((r["station"], int(r["day"])), []).append(float(r["pm25"])) 
    return {k: statistics.mean(v) for k, v in groups.items()} 
  
# Method 2: pandas groupby 
def mean_pandas(text): 
    df = pd.read_csv(io.StringIO(text)) 
    return df.groupby(["station", "day"])["pm25"].mean().to_dict() 
  
# Method 3: SQL GROUP BY (load into SQLite, then query) 
def mean_sql(text): 
    con = sqlite3.connect(":memory:") 
    con.execute("CREATE TABLE r (station TEXT, day INT, hour INT, pm25 REAL)") 
    rows = csv.reader(io.StringIO(text)); next(rows) 
    con.executemany("INSERT INTO r VALUES (?,?,?,?)", rows) 
    out = con.execute("SELECT station, day, AVG(pm25) FROM r GROUP BY station, day") 
    return {(s, d): m for s, d, m in out} 
  
# --------------------------------------------------------------------------- 
# B3.1 CORRECTNESS on small data: all three methods must agree 
# --------------------------------------------------------------------------- 
small = make_csv(2, days=3) 
a, b, c = mean_loops(small), mean_pandas(small), mean_sql(small) 
same = (a.keys() == b.keys() == c.keys() and 
        all(abs(a[k] - b[k]) < 1e-9 and abs(a[k] - c[k]) < 1e-9 for k in a)) 
print("Groups:", len(a), "| loops == pandas == SQL:", same) 
for k in sorted(a)[:3]: 
    print(f"  {k}: loops {a[k]:.3f} pandas {b[k]:.3f} sql {c[k]:.3f}") 
  
