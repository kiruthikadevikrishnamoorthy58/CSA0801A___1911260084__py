# =========================================================================== 
# executemany() versus execute() in a loop: time for n rows 
# =========================================================================== 
print(f"\n{'rows':>9} {'execute loop':>13} {'executemany':>12}") 
for n in (1_000, 10_000, 100_000): 
    data = [("Adyar", "2026-10-01", float(i)) for i in range(n)] 
    c1 = sqlite3.connect(":memory:") 
    c1.execute("CREATE TABLE aq (station TEXT, day TEXT, pm25 REAL)") 
    t = time.perf_counter() 
    for row in data: 
        c1.execute("INSERT INTO aq VALUES (?, ?, ?)", row) 
    c1.commit(); t_loop = time.perf_counter() - t 
    c2 = sqlite3.connect(":memory:") 
    c2.execute("CREATE TABLE aq (station TEXT, day TEXT, pm25 REAL)") 
    t = time.perf_counter() 
    c2.executemany("INSERT INTO aq VALUES (?, ?, ?)", data) 
    c2.commit(); t_many = time.perf_counter() - t 
    print(f"{n:>9,} {t_loop:>12.4f}s {t_many:>11.4f}s") 
# Both are O(n): every row is inserted once. executemany() runs the loop 
# inside C and prepares the statement once, so its constant per row is smaller 
# (less Python overhead). On a FILE database, commit once at the end in both 
# cases - committing after every row would be far slower (disk write each time). 
  
