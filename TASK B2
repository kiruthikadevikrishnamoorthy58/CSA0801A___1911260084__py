# PART 1: BAD FILES - missing column, wrong delimiter, other encoding, empty 
# =========================================================================== 
REQUIRED = ["station", "date", "pm25"] 
def load_file(raw_bytes): 
    """Defensive loader: returns (rows, message). Never crashes.""" 
    if not raw_bytes.strip(): 
        return [], "REJECTED: file is empty" 
    try: 
        text = raw_bytes.decode("utf-8") 
    except UnicodeDecodeError: 
        text = raw_bytes.decode("latin-1")              # fall back, then warn 
        note = " (decoded as latin-1, not UTF-8)" 
    else: 
        note = "" 
    first_line = text.splitlines()[0] 
    if "," not in first_line: 
        return [], f"REJECTED: expected comma delimiter, header was {first_line!r}" 
    reader = csv.DictReader(io.StringIO(text)) 
    missing = [c for c in REQUIRED if c not in (reader.fieldnames or [])] 
    if missing: 
        return [], f"REJECTED: missing column(s) {missing}" 
    rows = [r for r in reader if r["pm25"].strip() not in ("", "NA")] 
    return rows, f"ACCEPTED: {len(rows)} usable row(s){note}" 
