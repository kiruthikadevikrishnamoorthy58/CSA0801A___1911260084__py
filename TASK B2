    return "positive" if s > 0 else "negative" if s < 0 else "neutral" 
  
ADVERSARIAL = [ 
    ("Oh great, another smoky day. Wonderful.",        "negative", "sarcasm"), 
    ("Thanks for the fast response, only 3 weeks.",    "negative", "sarcasm"), 
    ("The service is not never helpful.",              "positive", "double negative"), 
    ("It is not that the air is not clean.",           "positive", "double negative"), 
    ("The staff were helpful but the air is dirty.",   "negative", "mixed opinion"), 
    ("Clean roads, good buses, but slow and rude officers.", "negative", "mixed"), 
    ("Not very good.",                                 "negative", "negator + gap"), 
] 
print("\n--- Sentiment scorer on adversarial sentences ---") 
wrong = 0 
for text, truth, kind in ADVERSARIAL: 
    got = label(text) 
    wrong += got != truth 
    print(f"{'ok  ' if got == truth else 'FAIL'} {kind:16} expected {truth:9} " 
          f"got {got}") 
    print(f"     \"{text}\"") 
print(f"failures: {wrong} of {len(ADVERSARIAL)}") 
  
# WHAT EACH ADVERSARIAL INPUT REVEALS ABOUT THE DESIGN 
#  - Sarcasm: the scorer reads WORDS, not intention. Positive words used 
#    ironically score +; it has no knowledge of tone, context or facts. 
#  - Double negative: it only looks at the ONE previous word, so "not never 
#    helpful" flips only once and the pairing logic is too shallow. 
#  - Mixed opinions: the total of +1 and -1 hides what the person said about 
#    each topic; a net score of 0 becomes "neutral" although the text is 
#    strongly critical. Splitting the text into clauses at "but" would help. 
#  - Vocabulary: "smoky" is not "smoke" - the word list needs word forms 
#    (stemming) and cannot cover every spelling or language. 
#  - Negator gap: "not very good" fails because the negator must be directly 
#    before the word. 
# Lesson: the lexicon scorer is fast and explainable but brittle; the design 
# should report low-confidence cases for a human to read instead of guessing.