STATIONS = [r[0] for r in con.execute("SELECT station FROM latest")] 
KEYWORDS = {"pm2.5": "pm25", "pm25": "pm25", "pm10": "pm10", "no2": "no2", 
            "temperature": "temp", "temp": "temp"} 
UNITS = {"pm25": "ug/m3", "pm10": "ug/m3", "no2": "ug/m3", "temp": "C"} 
NAMES = {"pm25": "PM2.5", "pm10": "PM10", "no2": "NO2", "temp": "Temperature"} 
  
def chatbot(question): 
    q = question.lower() 
    station = next((s for s in STATIONS if s.lower() in q), None) 
    column = next((col for key, col in KEYWORDS.items() if key in q), None) 
    if column is None: 
        return "Sorry, I can answer about PM2.5, PM10, NO2 and temperature." 
    if station is None: 
        return "Which station? I know: " + ", ".join(STATIONS) + "." 
    # the column name comes from OUR fixed dictionary; the station is a 
    # ? placeholder, so user text is never pasted into the SQL 
    value = con.execute(f"SELECT {column} FROM latest WHERE station = ? " 
                        "ORDER BY day DESC LIMIT 1", (station,)).fetchone()[0] 
    return f"{NAMES[column]} in {station} today is {value} {UNITS[column]}." 
  
