def train_nb(data): 
    counts = {"positive": Counter(), "negative": Counter()} 
    docs = Counter() 
    for text, lab in data: 
        counts[lab].update(words_of(text)); docs[lab] += 1 
    vocab = {w for c in counts.values() for w in c} 
    return counts, docs, vocab 
  
def predict_nb(model, text): 
    counts, docs, vocab = model 
    best, best_lp = None, -math.inf 
    for lab in counts: 
        total = sum(counts[lab].values()) 
        lp = math.log(docs[lab] / sum(docs.values())) 
        for w in words_of(text): 
15 
            lp += math.log((counts[lab][w] + 1) / (total + len(vocab)))  # Laplace 
        if lp > best_lp: 
            best, best_lp = lab, lp 
    return best 
  
