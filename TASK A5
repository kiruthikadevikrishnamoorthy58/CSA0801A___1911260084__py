# --------------------------------------------------------------------------- 
# A5.1(b) EXTRACTIVE SUMMARISER: pick the sentences that contain the most 
# frequent important words (stop words such as 'the', 'is' are ignored) 
# --------------------------------------------------------------------------- 
STOP = {"the", "a", "an", "is", "are", "was", "were", "of", "in", "on", "at", "and", 
        "to", "it", "this", "that", "for", "from", "with", "by", "our", "we", "has"} 
  
def summarise(text, n_sentences=2): 
    sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", text) if s.strip()] 
    freq = Counter(w for w in words_of(text) if w not in STOP) 
    def sentence_score(sentence): 
        ws = [w for w in words_of(sentence) if w not in STOP] 
        return sum(freq[w] for w in ws) / (len(ws) or 1)   # avoid long-sentence bias 
    best = sorted(sentences, key=sentence_score, reverse=True)[:n_sentences] 
    return [s for s in sentences if s in best]             # keep original order 
  
