# --------------------------------------------------------------------------- 
# A5.1(a) LEXICON-BASED SENTIMENT SCORER (handles negation) 
# Design: +1 per positive word, -1 per negative word; if the PREVIOUS word is a 
# negator (not, never, no) the sign flips:  "not good" = -1,  "not bad" = +1 
# --------------------------------------------------------------------------- 
POSITIVE = {"good", "clean", "fast", "helpful", "improved", "better", "fresh"} 
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken", "polluted", "choking"} 
NEGATORS = {"not", "never", "no"} 
  
def words_of(text): 
    return re.sub(r"[^a-z' ]", " ", text.lower()).split() 
  
def score(text): 
    words, total = words_of(text), 0 
    for i, w in enumerate(words): 
        value = 1 if w in POSITIVE else -1 if w in NEGATIVE else 0 
        if value and i > 0 and words[i - 1] in NEGATORS: 
            value = -value                      # negation flips the sign 
        total += value 
    return total 
  
def label(text): 
    s = score(text) 
    return "positive" if s > 0 else "negative" if s < 0 else "neutral" 
  
print("--- Sentiment scorer ---") 
for c in ["The air is good today.", "The air is not good today.", 
