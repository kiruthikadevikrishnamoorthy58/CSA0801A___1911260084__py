# --------------------------------------------------------------------------- 
# A2.1 CLEANING RULES (with justification) 
# --------------------------------------------------------------------------- 
# Rule 1  MISSING (blank / 'NA')  -> keep the row, store pm25 as None, then 
#         fill with the PREVIOUS value (forward fill) for short gaps. 
#         Why: air quality changes slowly hour to hour, so the last reading is 
#         a good estimate; dropping rows would shorten the day and bias the 
#         daily average toward the hours that happened to work. 
# Rule 2  IMPOSSIBLE (pm25 < 0 or > 999) -> treat as a sensor fault = missing. 
#         Why: concentrations cannot be negative; 999 ug/m3 is the top of the 
#         instrument range, so larger values are faults, not real air. 
# Rule 3  DUPLICATE rows (same station, date, hour) -> keep the first only. 
#         Why: a repeated row is a transmission error and would count one hour 
#         twice in the average. 
# Rule 4  FAHRENHEIT -> convert with C = (F - 32) * 5 / 9 for the stations 
#         that report F, so all temperatures are in Celsius. 
# --------------------------------------------------------------------------- 
def to_iso(date_text): 
    """A2.3: every date becomes YYYY-MM-DD.""" 
    for fmt in ("%Y-%m-%d", "%d/%m/%Y"): 
        try: 
            return datetime.strptime(date_text.strip(), fmt).strftime("%Y-%m-%d") 
        except ValueError: 
            pass 
    raise ValueError(f"unknown date format: {date_text!r}") 
  
def parse_pm(text): 
    text = text.strip() 
    if text in ("", "NA"): 
        return None                              # Rule 1 
    value = float(text) 
    if value < 0 or value > 999: 
        return None                              # Rule 2 
    return value 
  
def clean(text, fill="ffill"): 
    rows, seen = [], set() 
    for r in csv.DictReader(io.StringIO(text)): 
        station = r["station"].strip().title()   # A2.3: 'ADYAR' -> 'Adyar' 
        key = (station, to_iso(r["date"]), int(r["hour"])) 
        if key in seen:                          # Rule 3 
            continue 
        seen.add(key) 
        temp = float(r["temp"]) 
        if station in F_STATIONS:                # Rule 4 
            temp = (temp - 32) * 5 / 9 
        rows.append([station, key[1], key[2], parse_pm(r["pm25"]), round(temp, 1)]) 
    if fill == "ffill":                          # fill with the previous value 
6 
        last = None 
        for row in rows: 
            if row[3] is None: 
                row[3] = last 
            else: 
                last = row[3] 
    elif fill == "median":                       # fill with the median 
        med = statistics.median(r[3] for r in rows if r[3] is not None) 
        for row in rows: 
            if row[3] is None: 
                row[3] = med 
    elif fill == "drop":                         # drop the rows 
        rows = [r for r in rows if r[3] is not None] 
    return rows 
  
