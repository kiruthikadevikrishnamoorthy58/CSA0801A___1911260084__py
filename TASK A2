# A2.2 NORMALISATION of PM2.5 
# --------------------------------------------------------------------------- 
def min_max(values): 
    """(v - min) / (max - min)  -> 0 to 1. Good for charts, colour scales and 
    models that need a fixed range. Sensitive to outliers (one extreme value 
    squeezes all others together).""" 
    lo, hi = min(values), max(values) 
    return [round((v - lo) / (hi - lo), 3) for v in values] 
  
def z_score(values): 
    """(v - mean) / standard deviation -> mean 0, spread 1. Good for comparing 
    stations with different levels, for finding outliers (|z| > 3) and for 
    statistical methods; values are not limited to 0-1.""" 
    mean, sd = statistics.mean(values), statistics.pstdev(values) 
    return [round((v - mean) / sd, 3) for v in values] 
  
