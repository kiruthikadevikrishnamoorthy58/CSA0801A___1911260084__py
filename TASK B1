def make_raw(n, seed=4): 
    g = np.random.default_rng(seed) 
    pm = g.normal(70, 20, n).round(1).astype(str) 
    bad = g.random(n) 
    pm[bad < 0.03] = "NA" 
    pm[(bad >= 0.03) & (bad < 0.06)] = "" 
    pm[(bad >= 0.06) & (bad < 0.07)] = "-5" 
    pm[(bad >= 0.07) & (bad < 0.075)] = "5400" 
    st = g.choice(STATIONS, n) 
    return "station,date,pm25\n" + "\n".join( 
        f"{s},2026-10-01,{p}" for s, p in zip(st, pm)) 
  
def clean_loops(text): 
    vals = [] 
    for r in csv.DictReader(io.StringIO(text)): 
        v = r["pm25"].strip() 
        if v and v != "NA" and 0 <= float(v) <= 999: 
            vals.append(float(v)) 
    lo, hi = min(vals), max(vals) 
    return [(v - lo) / (hi - lo) for v in vals] 
  
def clean_pandas(text): 
20 
