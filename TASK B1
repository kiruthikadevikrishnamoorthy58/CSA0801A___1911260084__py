def to_iso(text): 
    for fmt in ("%Y-%m-%d", "%d/%m/%Y"): 
        try: 
            return datetime.strptime(text.strip(), fmt).strftime("%Y-%m-%d") 
        except ValueError: 
            pass 
    raise ValueError(f"unknown date format {text!r}") 
  
def number(text, low=0, high=999): 
    """float, or None when blank / 'NA' / negative / impossibly large.""" 
17 
    text = text.strip() 
    if text in ("", "NA"): 
        return None 
    v = float(text) 
    return v if low <= v <= high else None 
  
def clean_station_text(station, text): 
    """Cleans ONE station's CSV text -> list of tuples 
    (station, day, hour, pm25, pm10, no2, temp_c)""" 
    station = station.strip().title() 
    seen, rows = set(), [] 
    for r in csv.DictReader(io.StringIO(text)): 
        key = (to_iso(r["date"]), int(r["hour"])) 
        if key in seen: 
            continue                                   # duplicate row 
        seen.add(key) 
        temp = float(r["temp"]) 
        if station in F_STATIONS: 
            temp = (temp - 32) * 5 / 9                 # Fahrenheit -> Celsius 
        rows.append([station, key[0], key[1], number(r["pm25"]), number(r["pm10"]), 
                     number(r["no2"]), round(temp, 1)]) 
    for col in (3, 4, 5):                              # forward fill, per station 
        last = None 
        for row in rows: 
            if row[col] is None: 
                row[col] = last 
            else: 
                last = row[col] 
    return [tuple(r) for r in rows] 
  
