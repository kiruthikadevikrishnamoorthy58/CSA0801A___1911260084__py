# --------------------------------------------------------------------------- 
# ALTERNATIVE: print() for all debugging instead of logging + debugger 
# --------------------------------------------------------------------------- 
def with_print(values, debug): 
    n = 0 
    for v in values: 
        if debug: 
            print("value", v) 
        n += 1 
    return n 
  
def with_logging(values, logger): 
    n = 0 
    for v in values: 
        logger.debug("value %s", v) 
        n += 1 
    return n 
  
values = list(range(20_000)) 
real_stdout = sys.stdout 
sys.stdout = io.StringIO()                    # hide the 20,000 printed lines 
t = time.perf_counter(); with_print(values, True); t_print = time.perf_counter() - t 
sys.stdout = real_stdout 
  
logging.disable(logging.NOTSET) 
quiet = logging.getLogger("quiet"); quiet.setLevel(logging.WARNING)  # DEBUG off 
t = time.perf_counter(); with_logging(values, quiet); t_log_off = time.perf_counter() - t 
noisy = logging.getLogger("noisy"); noisy.setLevel(logging.DEBUG) 
noisy.propagate = False; noisy.addHandler(logging.StreamHandler(io.StringIO())) 
t = time.perf_counter(); with_logging(values, noisy); t_log_on = time.perf_counter() - t 
t = time.perf_counter(); with_print(values, False); t_flag_off = time.perf_counter() - t 
  
print("\n20,000 debug calls:") 
print(f"  print   ON {t_print:.4f}s | flag OFF {t_flag_off:.4f}s") 
print(f"  logging ON {t_log_on:.4f}s | level OFF {t_log_off:.4f}s") 
# Time added: each print/log call costs a few microseconds, so thousands of 
# calls add up to O(n) extra time; printing to a real screen or file is slower 
# still. Logging is the most expensive when ON (it builds a record object, then 
# formats it) but almost free when the level is raised: the call returns early. 
# Switching OFF when finished: 
#   print   -> must delete the lines or guard each with 'if DEBUG:' (easy to 
#              forget one; the check itself still costs time). 
#   logging -> change ONE setting: logging.disable(...) or setLevel(WARNING). 
#   assert  -> run Python with the -O option and all asserts are skipped.