# TASK A4 - Plan Debugging and Profiling (for the cleaning code) 
import cProfile, io, logging, pstats, random, sys, time, timeit 
  
# The function under test: a cleaning step with a deliberate BUG to hunt down 
def clean_pm(values): 
    out = [] 
    for v in values: 
        if v is None or v < 0 or v > 999: 
            continue 
        out.append(v) 
    return out 
  
